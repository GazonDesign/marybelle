# ── VPS (SSH) ──────────────────────────────────────────────
VPS_HOST=195.161.41.117
VPS_PORT=49295
VPS_USER=root
SSH_KEY_PATH=~/.ssh/id_ed25519

# ── Пути на VPS ───────────────────────────────────────────
SITE_REMOTE=/opt/mary-belle
CMS_REMOTE=/opt/mary-belle-cms

# ── Strapi CMS ────────────────────────────────────────────
STRAPI_URL=http://127.0.0.1:1337
STRAPI_TOKEN=your_strapi_api_token_here

# ── AmoCRM ─────────────────────────────────────────────────
AMO_SUBDOMAIN=marybelleadvyd
AMO_TOKEN=your_amo_token_here
AMO_WEBHOOK_SECRET=

# ── Telegram (прямой Bot API) ──────────────────────────────
MB_TG_BOT_TOKEN=your_telegram_bot_token_here
MB_TG_CHAT_ID=815792082

# ── Email (SMTP Яндекс) ───────────────────────────────────
EMAIL_TO=gazonmarketing@yandex.ru
SMTP_USER=gazonmarketing@yandex.ru
SMTP_PASS=your_app_password_here

# ── Яндекс Метрика (счётчик 29448140 захардкожен в коде) ───
METRIKA_OAUTH_TOKEN=your_metrika_oauth_token_here

# ── Payload CMS (рудимент) ─────────────────────────────────
PAYLOAD_SECRET=your_payload_secret_here

# ── Seed (только для первичного заполнения) ─────────────────
SEED_SECRET=changeme-only-for-local-seed
SEED_ADMIN_EMAIL=admin@mary-belle.ru
SEED_ADMIN_PASSWORD=your_admin_password_here
